# Copy to keys.env and fill in the ones you have. All have free tiers.
# The Gemini key is picked up from the Calibre plugin automatically if left out here.
GEMINI_API_KEY=        # aistudio.google.com -> Get API key
MISTRAL_API_KEY=       # console.mistral.ai -> API Keys (free "Experiment" plan, phone verification)
GITHUB_TOKEN=          # github.com/settings/tokens -> fine-grained token with "Models: read"
GROQ_API_KEY=          # console.groq.com/keys
CEREBRAS_API_KEY=      # cloud.cerebras.ai -> API Keys
OPENROUTER_API_KEY=    # openrouter.ai/keys (use free models; no credit needed)
